<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ==================== SUCURSALES ==================== -->

        <!-- Vista Tree para Sucursales -->
        <record id="view_apn_branch_tree" model="ir.ui.view">
            <field name="name">apn.branch.tree</field>
            <field name="model">res.company</field>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <list string="Branches"
                      decoration-info="not parent_company_id"
                      decoration-warning="not street">
                    <field name="active" widget="boolean_toggle"/>
                    <field string="Name" name="name" required="1"/>
                    <field name="parent_company_id" required="1"/>
                    <field name="city" optional="show"/>
                    <field name="phone" widget="phone" optional="show"/>
                    <field name="email" widget="email" optional="show"/>
                    <field name="room_count"/>
                    <field name="is_branch" column_invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Vista Form para Sucursales -->
        <record id="view_apn_branch_form" model="ir.ui.view">
            <field name="name">apn.branch.form</field>
            <field name="model">res.company</field>
            <field name="arch" type="xml">
                <form string="Branch">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="open_map"
                                    type="object"
                                    string="View on Map"
                                    class="oe_stat_button"
                                    icon="fa-map-marker"
                                    invisible="[('map_url', '=', False)]"/>
                            <button name="geo_localize"
                                    type="object"
                                    string="Geo Localize"
                                    class="oe_stat_button"
                                    icon="fa-globe"/>
                        </div>



                        <field name="is_branch" invisible="1"/>

                        <field name="logo" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <div class="oe_avatar">

                            </div>
                            <h1>
                                <field name="name" required="1" placeholder="Branch Name"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Branch Information">
                               <field name="parent_company_id"
                                       required="1"
                                       domain="[('is_branch', '=', False)]"/>
                               <field name="active" widget="boolean_toggle"/>
                            </group>
                            <group string="Contact">
                                <field name="phone" widget="phone"/>
                                <field name="email" widget="email"/>
                                <field name="website" widget="url"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Address &amp; Location">
                                <group string="Address">
                                    <group colspan="4">
                                        <field name="street" placeholder="Street..." required="1"/>
                                        <field name="street2" placeholder="Street 2..."/>
                                    </group>
                                    <group>
                                        <field name="city" placeholder="City" required="1"/>
                                        <field name="state_id" options="{'no_create': True}" required="1"/>
                                    </group>
                                    <group>
                                        <field name="zip" placeholder="ZIP" required="1"/>
                                        <field name="country_id" options="{'no_create': True}" required="1"/>
                                    </group>
                                    <group colspan="4">
                                        <field name="reference" placeholder="Nearby landmarks..."/>
                                    </group>
                                </group>

                                <group string="Coordinates">
                                    <group>
                                        <field name="latitude" placeholder="19.4326"/>
                                        <field name="longitude" placeholder="-99.1332"/>
                                    </group>
                                    <group colspan="4">
                                        <field name="map_url" readonly="1" widget="url"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Rooms &amp; Studios" name="rooms_studio">
                                <group col="1">
                                    <field name="room_ids"
                                            nolabel="1"
                                            required="1"
                                            context="{'default_branch_id': id}">
                                        <list editable="bottom">
                                            <field name="name"/>
                                            <field name="capacity"/>

                                        </list>
                                    </field>
                                </group>
                            </page>

                            <page string="Work Schedules" name="schedules">
                                <group col="1">
                                    <field name="schedule_ids"
                                            nolabel="1"
                                            context="{'branch_ids': id}"
                                            required="1"
                                    >
                                        <list edit="0" options="{'create': true, 'delete': true}">

                                            <field name="day_range"/>
                                            <field name="hour_from" widget="float_time"/>
                                            <field name="hour_to" widget="float_time"/>
                                        </list>
                                    </field>
                                </group>

                            </page>



                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista Kanban para Sucursales -->
        <record id="view_apn_branch_kanban" model="ir.ui.view">
            <field name="name">apn.branch.kanban</field>
            <field name="model">res.company</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="parent_company_id"/>
                    <field name="city"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="street"/>
                    <field name="map_url"/>
                    <field name="is_branch"/>
                    <field name="active"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <small class="text-muted ms-2">
                                            <field name="parent_company_id"/>
                                        </small>
                                    </div>
                                </div>
                                <div class="oe_kanban_content">
                                    <div class="text-muted" t-if="record.street.raw_value">
                                        <i class="fa fa-map-marker me-1"/>
                                        <field name="street"/>
                                        <t t-if="record.city.raw_value">, <field name="city"/></t>
                                    </div>
                                    <div t-if="record.phone.raw_value">
                                        <i class="fa fa-phone me-1"/>
                                        <field name="phone"/>
                                    </div>
                                    <div t-if="record.email.raw_value">
                                        <i class="fa fa-envelope me-1"/>
                                        <field name="email"/>
                                    </div>
                                </div>
                                <div class="oe_kanban_bottom_left">
                                    <a t-if="record.map_url.raw_value"
                                       t-att-href="record.map_url.raw_value"
                                       target="_blank"
                                       class="btn btn-sm btn-link">
                                        <i class="fa fa-map-marker"/> View Map
                                    </a>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vista Search para Sucursales -->
        <record id="view_apn_branch_search" model="ir.ui.view">
            <field name="name">apn.branch.search</field>
            <field name="model">res.company</field>
            <field name="arch" type="xml">
                <search string="Search Branches">
                    <field name="name"/>
                    <field name="parent_company_id"/>
                    <field name="city"/>
                    <field name="state_id"/>
                    <field name="country_id"/>
                    <separator/>


                    <filter string="Archived" name="inactive"
                            domain="[('active', '=', False)]"/>
                    <separator/>
                    <group expand="1" string="Group By">
                        <filter string="Company" name="group_company"
                                context="{'group_by': 'parent_company_id'}"/>
                        <filter string="City" name="group_city"
                                context="{'group_by': 'city'}"/>
                        <filter string="Country" name="group_country"
                                context="{'group_by': 'country_id'}"/>

                    </group>
                </search>
            </field>
        </record>

        <!-- Action para Sucursales -->
        <record id="action_apn_branch" model="ir.actions.act_window">
            <field name="name">Branches</field>
            <field name="res_model">res.company</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('is_branch', '=', True)]</field>
            <field name="search_view_id" ref="view_apn_branch_search"/>
            <field name="view_ids" eval="[ (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('apn_company.view_apn_branch_tree')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('apn_company.view_apn_branch_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('apn_company.view_apn_branch_form')})]"/>
            <field name="context">{'default_is_branch': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new branch
                </p>
            </field>
        </record>
    </data>
</odoo>