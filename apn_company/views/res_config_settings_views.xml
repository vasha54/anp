<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nearby_branches_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">nearby_branches_res_config_settings_view_form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='about']" position="before">
                <div class="app_settings_block" data-string="Branches" string="Branches">
                    <h2>Branches</h2>
                    <div class="row mt16">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <!-- optional icon -->
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="nearby_branches_default_distance_meters"/>
                                <field name="nearby_branches_default_distance_meters"
                                       help="Search radius in meters for nearby branches. It will be used as the default value in location searches."/>
                                <div class="text-muted">
                                    <small>Sets the maximum distance (in meters) to filter nearby branches. Example: 400 meters is approximately 4 blocks.</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>