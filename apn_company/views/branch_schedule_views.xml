<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_branch_schedule_form" model="ir.ui.view">
            <field name="name">branch.schedule.form</field>
            <field name="model">branch.schedule</field>
            <field name="arch" type="xml">
                <form string="Opening Hours">
                    <sheet>
                        <!-- Botón de sucursales -->
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_branches"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-building"
                                    invisible="[('branch_count', '=', 0)]">
                                <field name="branch_count" widget="statinfo"
                                       string="Branches"/>
                            </button>
                        </div>

                        <div class="oe_title">
                            <label for="display_name"/>
                            <h1>
                                <field name="display_name" readonly="1"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Days">
                                <field name="day_of_week_from" readonly="branch_ids"/>
                                <field name="day_of_week_to" readonly="branch_ids"/>
                            </group>
                            <group string="Hours" >
                                <field name="hour_from"
                                       widget="float_time" readonly="branch_ids"/>
                                <field name="hour_to"
                                       widget="float_time" readonly="branch_ids"/>
                            </group>
                        </group>

                        <!-- Alerta si está en uso -->
                        <div class="alert alert-warning"
                             role="alert"
                             invisible="[('branch_count', '=', 0)]">
                            <i class="fa fa-lock me-2"/>
                            <strong>This opening hours is in use.</strong>
                            Days and hours cannot be modified while the opening hours
                            is assigned to one or more branches.
                        </div>

                        <!-- Resumen -->
                        <group>
                            <group string="Opening Hours Summary" colspan="2">
                                <div class="alert alert-info" role="alert">
                                    <field name="day_range" readonly="1" nolabel="1"/>
                                    <field name="hour_range" readonly="1" nolabel="1"/>
                                </div>
                            </group>
                        </group>

                        <group string="Branches">
                            <field name="branch_ids"
                                   string="Assigned Branches"
                                   widget="many2many_tags"
                                   options="{'no_create': True}">
                                <list>
                                    <field name="name"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <field name="city"/>
                                </list>
                            </field>
                        </group>

                        <group string="Additional Information">
                           <field name="notes" widget="textarea" rows="7" nolabel="1"
                                       placeholder="Any special considerations..."/>

                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_branch_schedule_list" model="ir.ui.view">
            <field name="name">branch.schedule.list</field>
            <field name="model">branch.schedule</field>
            <field name="arch" type="xml">
                <list string="Work Schedules"
                      decoration-warning="branch_count > 0">

                    <field name="display_name" string="Schedule"/>
                    <field name="day_range" optional="hide"/>
                    <field name="hour_range"/>
                    <field name="branch_count" string="Branches"/>

                </list>
            </field>
        </record>

        <record id="view_branch_schedule_kanban" model="ir.ui.view">
            <field name="name">branch.schedule.kanban</field>
            <field name="model">branch.schedule</field>
            <field name="arch" type="xml">
                <kanban string="Work Schedules"
                        class="o_kanban_mobile"
                        sample="1">
                    <field name="id"/>
                    <field name="display_name"/>
                    <field name="day_range"/>
                    <field name="hour_range"/>
                    <field name="branch_count"/>
                    <field name="branch_ids"/>
                    <field name="active"/>
                    <field name="crosses_midnight"/>
                    <field name="notes"/>


                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <i class="fa fa-clock-o fa-2x"/>
                                </div>

                                <div class="oe_kanban_content">
                                    <!-- Cabecera -->
                                    <div class="o_kanban_record_head">
                                        <strong class="o_kanban_record_title">
                                            <field name="display_name"/>
                                        </strong>
                                    </div>

                                    <!-- Detalles del horario -->
                                    <div class="o_kanban_record_body mt-2">
                                        <div class="mb-2">
                                            <span class="badge bg-info">
                                                <field name="day_range"/>
                                            </span>
                                        </div>

                                        <div class="mb-2">
                                            <span class="badge bg-primary">
                                                <field name="hour_range"/>
                                            </span>
                                        </div>

                                        <!-- Indicador de cruce de medianoche -->
                                        <div t-if="record.crosses_midnight.raw_value"
                                             class="mb-2">
                                            <i class="fa fa-moon-o text-warning"/>
                                            <small class="text-muted">Night shift</small>
                                        </div>

                                        <!-- Sucursales asignadas -->
                                        <div class="o_kanban_tags mt-2">
                                            <t t-foreach="record.branch_ids.raw_value"
                                               t-as="branch">
                                                <span class="oe_kanban_tag"
                                                      t-esc="branch[1]"/>
                                            </t>
                                        </div>
                                    </div>

                                    <!-- Notas -->
                                    <div t-if="record.notes.raw_value"
                                         class="o_kanban_record_details mt-2">
                                        <small class="text-muted">
                                            <i class="fa fa-sticky-note-o me-1"/>
                                            <t t-esc="record.notes.raw_value"/>
                                        </small>
                                    </div>

                                    <!-- Footer -->
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <!-- Conteo de sucursales -->
                                            <span t-if="record.branch_count.raw_value > 0"
                                                  class="badge rounded-pill bg-success me-2">
                                                <i class="fa fa-building me-1"/>
                                                <t t-esc="record.branch_count.raw_value"/>
                                            </span>

                                            <!-- Estado activo/inactivo -->
                                            <span t-if="!record.active.raw_value"
                                                  class="badge rounded-pill bg-danger">
                                                <i class="fa fa-ban me-1"/>
                                                Inactive
                                            </span>
                                        </div>

                                        <div class="oe_kanban_bottom_right">
                                            <i class="fa fa-chevron-right text-muted"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_branch_schedule_search" model="ir.ui.view">
            <field name="name">branch.schedule.search</field>
            <field name="model">branch.schedule</field>
            <field name="arch" type="xml">
                <search string="Work Schedules">
                    <field name="display_name"/>
                    <field name="day_of_week_from"/>
                    <field name="day_of_week_to"/>

                    <filter string="Active" name="active"
                            domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive"
                            domain="[('active', '=', False)]"/>

                    <separator/>

<!--                    <filter string="In Use" name="in_use"-->
<!--                            domain="[('branch_count', '>', 0)]"/>-->
<!--                    <filter string="Not Assigned" name="not_assigned"-->
<!--                            domain="[('branch_count', '=', 0)]"/>-->

                    <group expand="0" string="Group By">
                        <filter string="Start Day" name="group_by_day"
                                context="{'group_by': 'day_of_week_from'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_branch_schedule" model="ir.actions.act_window">
            <field name="name">Opening Hours</field>
            <field name="res_model">branch.schedule</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_branch_schedule_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a work schedule
                </p>
                <p>
                    Define Opening Hours and assign them to your branches.
                    Opening Hours can be shared across multiple branches.
                </p>
            </field>
        </record>
    </data>
</odoo>