<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================ -->
        <!-- HORARIOS DE PILATES - TODOS LOS MOMENTOS      -->
        <!-- ============================================ -->

        <!-- MATUTINOS TEMPRANO (Lunes a Viernes) -->
        <!-- 6:00 AM - 7:00 AM: Madrugadores -->
        <record id="schedule_early_morning_weekdays" model="branch.schedule">
            <field name="day_of_week_from">0</field> <!-- Monday -->
            <field name="day_of_week_to">4</field>   <!-- Friday -->
            <field name="hour_from">6.0</field>      <!-- 06:00 -->
            <field name="hour_to">7.0</field>        <!-- 07:00 -->
            <field name="notes">Early bird session for clients before work</field>
        </record>

        <!-- MATUTINO MEDIO (Lunes a Viernes) -->
        <!-- 7:00 AM - 8:00 AM: Antes del trabajo -->
        <record id="schedule_morning_before_work" model="branch.schedule">
            <field name="day_of_week_from">0</field> <!-- Monday -->
            <field name="day_of_week_to">4</field>   <!-- Friday -->
            <field name="hour_from">7.0</field>      <!-- 07:00 -->
            <field name="hour_to">8.0</field>        <!-- 08:00 -->
            <field name="notes">Pre-work energizing pilates session</field>
        </record>

        <!-- MATUTINO MEDIO-2 (Lunes a Viernes) -->
        <!-- 8:00 AM - 9:00 AM: Mañana fitness -->
        <record id="schedule_morning_fitness" model="branch.schedule">
