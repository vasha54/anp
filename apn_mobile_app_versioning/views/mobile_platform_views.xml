<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view para plataformas -->
    <record id="view_mobile_platform_tree" model="ir.ui.view">
        <field name="name">mobile.platform.tree</field>
        <field name="model">mobile.platform</field>
        <field name="arch" type="xml">
            <list string="Platforms">
                <field name="active"/>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <!-- Form view para plataformas -->
    <record id="view_mobile_platform_form" model="ir.ui.view">
        <field name="name">mobile.platform.form</field>
        <field name="model">mobile.platform</field>
        <field name="arch" type="xml">
            <form string="Platform">
                <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Ej: iOS"/>
                        </h1>
                </div>
                <group>
                    <group>
                        <field name="code" placeholder="Ej: ios"/>
                    </group>
                    <group>
                        <field name="active" widget="tooglebutton"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mobile_platform" model="ir.actions.act_window">
        <field name="name">Platforms</field>
        <field name="res_model">mobile.platform</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and manage mobile platforms.
            </p>
        </field>
    </record>
</odoo>