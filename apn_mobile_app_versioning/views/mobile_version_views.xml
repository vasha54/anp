<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search view -->
    <record id="view_mobile_version_search" model="ir.ui.view">
        <field name="name">mobile.version.search</field>
        <field name="model">mobile.version</field>
        <field name="arch" type="xml">
            <search string="Search Versions">
                <field name="version"/>
                <field name="platform_id"/>
                <field name="company_id"/>
                <filter name="mandatory" string="Mandatory" domain="[('is_mandatory','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_platform" string="Platform" context="{'group_by':'platform_id'}"/>
                    <filter name="group_mandatory" string="Mandatory" context="{'group_by':'is_mandatory'}"/>
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tree view -->
    <record id="view_mobile_version_tree" model="ir.ui.view">
        <field name="name">mobile.version.tree</field>
        <field name="model">mobile.version</field>
        <field name="arch" type="xml">
            <list string="Versions">
                <field name="display_name" string="Version"/>
                <field name="platform_id"/>
                <field name="release_date"/>
                <field name="is_mandatory" widget="boolean_toggle"/>
                <field name="download_url" widget="url"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_mobile_version_form" model="ir.ui.view">
        <field name="name">mobile.version.form</field>
        <field name="model">mobile.version</field>
        <field name="arch" type="xml">
            <form string="Mobile Version">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" placeholder="Version name..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Version Details">
                            <field name="company_id"/>
                            <field name="version" placeholder="Ej: 2.1.0"/>
                            <field name="platform_id" options="{'no_create': False}"/>
                            <field name="release_date"/>
                        </group>
                        <group string="Distribution">
                            <field name="download_url" placeholder="https://..." widget="url"/>
                            <field name="is_mandatory"/>
                        </group>
                    </group>
                    <separator string="Release Notes"/>
                    <field nolabel="1" name="release_notes" placeholder="Escribe las novedades de esta versión..."/>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mobile_version" model="ir.actions.act_window">
        <field name="name">Versions</field>
        <field name="res_model">mobile.version</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mobile_version_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new version for your mobile apps.
            </p>
        </field>
    </record>
</odoo>