<odoo>
    <!-- ============================================ -->
    <!-- 2. VISTA LISTA (Tree)                        -->
    <!-- ============================================ -->
    <record id="view_list_product_tag_accessories" model="ir.ui.view">
        <field name="name">product.tag.accessories.list</field>
        <field name="model">product.tag</field>
        <field name="arch" type="xml">
            <list string="Product Tags" multi_edit="1" sample="1">
                <field name="name" string="Tag Name"/>
                <field name="color" widget="color_picker"/>
                <field name="sequence" widget="handle"/>
            </list>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- 3. VISTA FORMULARIO                          -->
    <!-- ============================================ -->
    <record id="view_form_product_tag_accessories" model="ir.ui.view">
        <field name="name">product.tag.accessories.form</field>
        <field name="model">product.tag</field>
        <field name="arch" type="xml">
            <form string="Product Tag">
                <sheet>

                    <group>
                        <group>
                            <field name="name" string="Tag Name"
                                   placeholder="e.g. New Arrival"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="sequence"/>

                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================ -->
<!-- 4. VISTA KANBAN                              -->
<!-- ============================================ -->
<record id="view_kanban_product_tag_accessories" model="ir.ui.view">
    <field name="name">product.tag.accessories.kanban</field>
    <field name="model">product.tag</field>
    <field name="arch" type="xml">
        <kanban sample="1" class="o_kanban_small_column">
            <templates>
                <t t-name="card">
                    <div class="oe_kanban_card oe_kanban_global_click">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <field name="color" widget="color_picker"
                                       options="{'no_label': True}"/>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>


<!-- ============================================ -->
<!-- 5. BÚSQUEDA (Search View)                    -->
<!-- ============================================ -->
<record id="view_search_product_tag_accessories" model="ir.ui.view">
    <field name="name">product.tag.accessories.search</field>
    <field name="model">product.tag</field>
    <field name="arch" type="xml">
        <search string="Search Tags">
            <field name="name" string="Tag Name"
                   filter_domain="[('name', 'ilike', self)]"/>
        </search>
    </field>
</record>


<!-- ============================================ -->
<!-- 6. ACCIÓN DE VENTANA                         -->
<!-- ============================================ -->
<record id="action_product_tag_accessories" model="ir.actions.act_window">
    <field name="name">Accessories Tags</field>
    <field name="res_model">product.tag</field>
    <field name="view_mode">list,kanban,form</field>
    <field name="search_view_id" ref="view_search_product_tag_accessories"/>
    <field name="view_ids" eval="[
        (5, 0, 0),
        (0, 0, {
            'view_mode': 'list',
            'view_id': ref('view_list_product_tag_accessories')
        }),
        (0, 0, {
            'view_mode': 'kanban',
            'view_id': ref('view_kanban_product_tag_accessories')
        }),
        (0, 0, {
            'view_mode': 'form',
            'view_id': ref('view_form_product_tag_accessories')
        })
    ]"/>
</record>


</odoo>











