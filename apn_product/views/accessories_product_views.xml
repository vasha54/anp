<odoo>

    <!-- ============================================ -->
    <!-- Vista Lista (Tree) para Accessories          -->
    <!-- ============================================ -->
    <record id="view_list_accessories_product_template" model="ir.ui.view">
        <field name="name">accessories.product.template.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Product">

                <!-- Header con botones de acción -->
                <header>
                    <button string="Print Labels" type="object"
                            name="action_open_label_layout"/>
                </header>

                <!-- Campos invisibles -->
                <field name="product_variant_count" column_invisible="True"/>
                <field name="sale_ok" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="cost_currency_id" column_invisible="True"/>
                <field name="active" column_invisible="True"/>

                <!-- Favorito -->
                <field name="is_favorite" widget="boolean_favorite"
                       optional="show" nolabel="1"/>

                <!-- Nombre del producto -->
                <field name="name" string="Product Name"/>

                <!-- Código de referencia -->
                <field name="default_code" optional="show"/>

                <!-- Etiquetas -->
                <field name="product_tag_ids" widget="many2many_tags"
                       optional="show"/>

                <!-- Código de barras -->
                <field name="barcode" optional="hide"
                       readonly="product_variant_count != 1"/>

                <!-- Compañía -->
                <field string="Branches" widget="many2many_tags" name="company_ids" options="{'no_create': True}"
                        optional="hide"/>

                <!-- Precio de venta -->
                <field name="list_price" string="Sales Price" widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       optional="show" decoration-muted="not sale_ok"/>

                <!-- Precio de costo -->
                <field name="standard_price" widget="monetary"
                       options="{'currency_field': 'cost_currency_id'}"
                       optional="show" readonly="1"/>

                <!-- Categoría -->
                <field name="categ_id" optional="hide"/>

                <!-- Tipo de producto -->
                <field name="type" optional="hide" readonly="1"/>

                <field name="qty_available" optional="hide" readonly="1"/>

                <field name="virtual_available" optional="hide" readonly="1"/>

                <!-- Unidad de medida -->
                <field name="uom_id" string="Unit" readonly="1"
                       optional="show"/>

                <!-- Indicador de actividad -->
                <field name="activity_exception_decoration"
                       widget="activity_exception"/>

            </list>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- Vista Kanban para Accessories               -->
    <!-- ============================================ -->
    <record id="view_kanban_accessories_product_template" model="ir.ui.view">
        <field name="name">accessories.product.template.kanban</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <kanban sample="1">

                <!-- Campos necesarios para la vista -->
                <field name="currency_id"/>
                <field name="activity_state"/>
                <field name="categ_id"/>

                <!-- Barra de progreso por estado de actividad -->
                <progressbar field="activity_state"
                             colors='{"planned": "success",
                                      "today": "warning",
                                      "overdue": "danger"}'
                />

                <!-- Plantillas de las tarjetas -->
                <templates>
                    <t t-name="card" class="flex-row">

                        <!-- Contenido principal -->
                        <main class="pe-2">

                            <!-- Cabecera con nombre y favorito -->
                            <div class="mb-1">
                                <div class="d-flex mb-0 h5">
                                    <field class="me-1" name="is_favorite"
                                           widget="boolean_favorite" nolabel="1"/>
                                    <field name="name"/>
                                </div>

                                <!-- Código de referencia (si existe) -->
                                <span t-if="record.default_code.value">
                                    [<field name="default_code"/>]
                                </span>

                                <!-- Número de variantes (si tiene más de 1) -->
                                <strong t-if="record.product_variant_count.value &gt; 1">
                                    <field name="product_variant_count"/> Variants
                                </strong>
                            </div>

                            <!-- Precio -->
                            <span>
                                Price:
                                <field name="list_price" widget="monetary"
                                       options="{'currency_field': 'currency_id',
                                                 'field_digits': True}"/>
                            </span>

                            <!-- Propiedades del producto -->
                            <field name="product_properties" widget="properties"/>

                        </main>

                        <!-- Imagen del producto -->
                        <aside>
                            <field name="image_128" widget="image" alt="Product"
                                   options="{'img_class': 'w-100 object-fit-contain'}"
                                   invisible="not image_128"/>
                        </aside>

                    </t>
                </templates>

            </kanban>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- Vista Formulario para Accessories            -->
    <!-- ============================================ -->
    <record id="view_form_accessories_product_template" model="ir.ui.view">
        <field name="name">accessories.product.template.form</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form string="Product">

                <!-- Header con botones de acción -->
                <header>
                    <button string="Update Quantity" type="object"
                            name="action_update_quantity_on_hand"/>
                    <button string="Replenish" type="action" name="325"
                            context="{'default_product_tmpl_id': id}"/>
                    <button string="Print Labels" type="object"
                            name="action_open_label_layout"/>
                </header>

                <sheet name="product_form">

                    <!-- Campos invisibles de control -->
                    <field name="product_variant_count" invisible="1"/>
                    <field name="is_product_variant" invisible="1"/>
                    <field name="attribute_line_ids" invisible="1"/>
                    <field name="company_id" invisible="1"/>

                    <!-- Caja de botones estadísticos -->
                    <div class="oe_button_box" name="button_box">

                        <!-- Lista de precios -->
                        <button class="oe_stat_button" name="open_pricelist_rules"
                                icon="fa-list-ul" groups="product.group_product_pricelist"
                                type="object">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value o_row">
                                    <field name="pricelist_item_count"/>
                                    <span class="o_stat_text"
                                          invisible="pricelist_item_count == 1">Rules</span>
                                    <span class="o_stat_text"
                                          invisible="pricelist_item_count != 1">Rule</span>
                                </span>
                                <span class="o_stat_text"
                                      invisible="pricelist_item_count == 1">Pricelists</span>
                                <span class="o_stat_text"
                                      invisible="pricelist_item_count != 1">Pricelist</span>
                            </div>
                        </button>

                        <!-- Separador para botones de website -->
                        <span id="button_website" invisible="1"/>

                        <!-- Documentos -->
                        <button class="oe_stat_button" name="action_open_documents"
                                type="object" icon="fa-file-text-o">
                            <field string="Documents" name="product_document_count"
                                   widget="statinfo"/>
                        </button>

                        <!-- Variantes -->
                        <button name="176" type="action" icon="fa-sitemap"
                                class="oe_stat_button">
                            <field string="Variants" name="product_variant_count"
                                   widget="statinfo"/>
                        </button>

                        <!-- Cantidad disponible -->
                        <button type="object" name="action_update_quantity_on_hand"
                                class="oe_stat_button" icon="fa-cubes">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value d-flex gap-1">
                                    <field name="qty_available" nolabel="1" class="oe_inline"/>
                                    <field name="uom_name" class="oe_inline"/>
                                </span>
                                <span class="o_stat_text">On Hand</span>
                            </div>
                        </button>

                        <!-- Pronóstico -->
                        <button type="object" name="action_product_tmpl_forecast_report"
                                context="{'default_product_tmpl_id': id}"
                                class="oe_stat_button" icon="fa-area-chart">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value d-flex gap-1">
                                    <field name="virtual_available" nolabel="1" class="oe_inline"/>
                                    <field name="uom_name" class="oe_inline"/>
                                </span>
                                <span class="o_stat_text">Forecasted</span>
                            </div>
                        </button>

                        <!-- Movimientos de stock -->
                        <button type="object" name="action_view_stock_move_lines"
                                class="oe_stat_button" icon="fa-exchange">
                            <div class="d-flex flex-column">
                                <div class="o_field_widget o_stat_info
                                            align-items-baseline flex-row gap-1 me-1">
                                    <span class="o_stat_text">In:</span>
                                    <span class="o_stat_value">
                                        <field name="nbr_moves_in"/>
                                    </span>
                                </div>
                                <div class="o_field_widget o_stat_info
                                            align-items-baseline flex-row gap-1 me-1">
                                    <span class="o_stat_text">Out:</span>
                                    <span class="o_stat_value">
                                        <field name="nbr_moves_out"/>
                                    </span>
                                </div>
                            </div>
                        </button>

                        <!-- Reglas de reordenamiento (Min/Max) -->
                        <button type="object" name="action_view_orderpoints"
                                class="oe_stat_button" icon="fa-refresh">
                            <div class="d-flex flex-column">
                                <div class="o_field_widget o_stat_info
                                            align-items-baseline flex-row gap-1 me-1">
                                    <span class="o_stat_text">Min:</span>
                                    <span class="o_stat_value">
                                        <field name="reordering_min_qty"/>
                                    </span>
                                </div>
                                <div class="o_field_widget o_stat_info
                                            align-items-baseline flex-row gap-1 me-1">
                                    <span class="o_stat_text">Max:</span>
                                    <span class="o_stat_value">
                                        <field name="reordering_max_qty"/>
                                    </span>
                                </div>
                            </div>
                        </button>

                        <!-- Número de reglas de reordenamiento -->
                        <button type="object" name="action_view_orderpoints"
                                class="oe_stat_button" icon="fa-refresh">
                            <field name="nbr_reordering_rules" widget="statinfo"/>
                        </button>

                        <!-- Lotes/Números de serie -->
                        <button type="object" name="action_open_product_lot"
                                class="oe_stat_button" icon="fa-bars">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Lot/Serial Numbers</span>
                            </div>
                        </button>

                        <!-- Reglas Putaway -->
                        <button type="object" name="action_view_related_putaway_rules"
                                class="oe_stat_button" icon="fa-random"
                                context="{'invisible_handle': True,
                                         'single_product': product_variant_count == 1}">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Putaway Rules</span>
                            </div>
                        </button>

                        <!-- Capacidades de almacenamiento -->
                        <button type="object" name="action_view_storage_category_capacity"
                                class="oe_stat_button" icon="fa-cubes">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Storage Capacities</span>
                            </div>
                        </button>

                        <!-- Ventas -->
                        <button class="oe_stat_button" name="action_view_sales"
                                type="object" icon="fa-signal"
                                help="Sold in the last 365 days"
                                groups="sales_team.group_sale_salesman"
                                invisible="not sale_ok">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value d-flex gap-1">
                                    <field name="sales_count" widget="statinfo"
                                           nolabel="1" class="oe_inline"/>
                                    <field name="uom_name" class="oe_inline"/>
                                </span>
                                <span class="o_stat_text">Sold</span>
                            </div>
                        </button>

                    </div><!-- Fin button_box -->

                    <!-- Ribbon de archivado -->
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>

                    <!-- Campo ID oculto -->
                    <field name="id" invisible="True"/>

                    <!-- Imagen del producto -->
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'convert_to_webp': True,
                                     'preview_image': 'image_128'}"/>

                    <!-- Título del producto -->
                    <div class="oe_title">
                        <label for="name" string="Accessory Template"/>
                        <h1>
                            <div class="d-flex">
                                <field name="is_favorite" widget="boolean_favorite"
                                       class="me-3" nolabel="1"/>
                                <field class="text-break" name="name"
                                       options="{'line_breaks': False}"
                                       widget="text"
                                       placeholder="e.g. Cheese Burger"/>
                            </div>
                        </h1>
                    </div>

                    <!-- Opciones de venta/compra -->
                    <div name="options">
                        <span class="d-inline-flex">
                            <field name="sale_ok"/>
                            <label for="sale_ok"/>
                        </span>
                        <span class="d-inline-flex">
                            <field name="purchase_ok"/>
                            <label for="purchase_ok"/>
                        </span>
                    </div>

                    <!-- Notebook con pestañas -->
                    <notebook>

                        <!-- Pestaña: Información General -->
                        <page string="General Information" name="general_information">
                            <group>

                                <!-- Columna izquierda -->
                                <group name="group_general">
                                    <field name="type"/>
                                    <field name="uom_id" options="{'no_create': True}"/>
                                    <field name="product_tag_ids" widget="many2many_tags" />
                                    <field name="active" invisible="1"/>
                                    <separator string="Description" />
                                    <field name="description" nolabel="1" widget="textarea" rows="4" />
                                </group>

                                <!-- Columna derecha -->
                                <group name="group_standard_price">

                                    <!-- Precio de venta -->
                                    <label for="list_price"/>
                                    <div name="list_price_uom">
                                        <field name="list_price" class="oe_inline"
                                               widget="monetary"
                                               options="{'currency_field': 'currency_id',
                                                         'field_digits': True}"/>
                                        <span name="uom_span" groups="uom.group_uom"
                                              invisible="type == 'combo'">
                                            per
                                            <field name="uom_id" class="oe_inline"
                                                   style="max-width:136px"
                                                   options="{'no_create': True}"/>
                                            <field name="tax_string" class="oe_inline"/>
                                        </span>
                                    </div>

                                    <!-- Impuestos -->
                                    <field name="taxes_id" widget="many2many_tags"/>

                                    <!-- Precio de costo -->
                                    <label for="standard_price"
                                           invisible="(id and product_variant_count != 1
                                                      and not is_product_variant)
                                                      or type == 'combo'"
                                           id="standard_price_label"/>
                                    <div name="standard_price_uom"
                                         invisible="(id and product_variant_count != 1
                                                    and not is_product_variant)
                                                    or type == 'combo'">
                                        <field name="standard_price" class="oe_inline"
                                               widget="monetary"
                                               options="{'currency_field': 'cost_currency_id',
                                                         'field_digits': True}"/>
                                        <span groups="uom.group_uom">
                                            per
                                            <field name="uom_name" class="oe_inline"/>
                                        </span>
                                    </div>

                                    <!-- Categoría -->
                                    <field name="categ_id" string="Category" readonly="1"/>

                                    <!-- Referencia -->
                                    <field name="default_code" string="Reference"
                                           invisible="product_variant_count &gt; 1"/>

                                    <field name="valid_product_template_attribute_line_ids"
                                           invisible="1"/>

                                    <!-- Código de barras -->
                                    <field name="barcode"
                                           invisible="product_variant_count &gt; 1
                                                      or (product_variant_count == 0
                                                          and valid_product_template_attribute_line_ids)
                                                      or type in ['service', 'combo']"/>

                                    <!-- Sucursales -->
                                    <field string="Branches" name="company_ids"
                                           widget="many2many_tags"
                                           domain="[('is_branch','=', True)]"
                                           options="{'no_create': True}"
                                           placeholder="Visible to all"/>

                                    <!-- Campos de moneda ocultos -->
                                    <field name="currency_id" invisible="1"/>
                                    <field name="cost_currency_id" invisible="1"/>
                                    <field name="product_variant_id" invisible="1"/>

                                </group>

                            </group>

                            <!-- Notas internas -->
                            <group name="internal_notes" string="Internal Notes">
                                <field colspan="2" name="description" nolabel="1"
                                       placeholder="This note is only for internal purposes."/>
                            </group>

                        </page>

                        <!-- Pestaña: Atributos y Variantes -->
                        <page name="variants" string="Attributes &amp; Variants"
                              groups="product.group_product_variant"
                              invisible="type == 'combo'">

                            <field name="attribute_line_ids" widget="one2many"
                                   context="{'show_attribute': False}">
                                <list string="Variants" editable="bottom"
                                      decoration-info="value_count &lt;= 1">
                                    <field name="value_count" column_invisible="True"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="attribute_id" readonly="id"/>
                                    <field name="value_ids" widget="many2many_tags"
                                           options="{'no_create_edit': True,
                                                     'color_field': 'color'}"
                                           context="{'default_attribute_id': attribute_id,
                                                     'show_attribute': False}"/>
                                    <button string="Configure" class="float-end btn-secondary"
                                            type="object"
                                            name="action_open_attribute_values"
                                            groups="product.group_product_variant"/>
                                </list>
                            </field>

                            <!-- Advertencia -->
                            <p class="oe_grey oe_edit_only">
                                <strong>Warning</strong>: adding or deleting attributes
                                will delete and recreate existing variants and lead
                                to the loss of their possible customizations.
                            </p>

                        </page>

                    </notebook>

                </sheet>

                <!-- Chatter -->
                <chatter/>

            </form>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- Acción de ventana para Accessories           -->
    <!-- ============================================ -->
    <record id="action_accessories_products" model="ir.actions.act_window">
        <field name="name">Accessories</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain"
               eval="[('categ_id', '=', ref('apn_product.cat_accessories'))]"/>
        <field name="context" eval="{
        'default_categ_id': ref('apn_product.cat_accessories'),
        }"/>

        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {
                'view_mode': 'list',
                'view_id': ref('view_list_accessories_product_template')
            }),
            (0, 0, {
                'view_mode': 'kanban',
                'view_id': ref('view_kanban_accessories_product_template')
            }),
            (0, 0, {
                'view_mode': 'form',
                'view_id': ref('view_form_accessories_product_template')
            })
        ]"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent">
                No products were found matching those criteria.
            </p>
        </field>
    </record>

</odoo>