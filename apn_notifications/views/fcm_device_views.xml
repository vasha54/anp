<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View - Solo lectura, no permite crear ni editar -->
    <record id="view_fcm_device_form" model="ir.ui.view">
        <field name="name">fcm.device.form</field>
        <field name="model">fcm.device</field>
        <field name="arch" type="xml">
            <form string="FCM Device"
                  create="false"
                  edit="false">
                <header>
                    <button name="test_firebase_configuration"
                            type="object"
                            string="Test Firebase Configuration"
                            class="btn-primary"/>
                    <button name="clean_invalid_tokens"
                            type="object"
                            string="Clean Invalid Tokens"
                            class="btn-secondary"/>
                    <field name="active"
                           widget="boolean_toggle"
                           string="Active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="device_name"
                                   placeholder="Device Name"
                                   readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Device Information">
                            <field name="user_id"
                                   string="User"
                                   readonly="1"
                                   options="{'no_create': True}"/>
                            <field name="platform"
                                   string="Platform"
                                   readonly="1"/>
                            <field name="last_seen"
                                   string="Last Seen"
                                   readonly="1"/>
                            <field name="active"
                                   string="Active"
                                   readonly="1"
                                   invisible="1"/>
                        </group>
                        <group string="Technical Information">
                            <field name="token"
                                   string="FCM Token"
                                   readonly="1"/>
                            <field name="create_date"
                                   string="Created On"
                                   readonly="1"/>
                            <field name="write_date"
                                   string="Last Updated"
                                   readonly="1"/>
                        </group>
                    </group>
                    <group string="Token Status"
                           colspan="4">
                        <field name="token"
                               string="FCM Token"
                               readonly="1"
                               nolabel="1"
                               class="oe_inline"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View - No permite crear -->
    <record id="view_fcm_device_list" model="ir.ui.view">
        <field name="name">fcm.device.list</field>
        <field name="model">fcm.device</field>
        <field name="arch" type="xml">
            <list string="FCM Devices"
                  default_order="last_seen desc"
                  create="false"
                  decoration-muted="active == False"
                  decoration-danger="last_seen &lt; (context_today() - relativedelta(days=90))">
                <field name="active"
                       string="Active"
                       widget="boolean_toggle"/>
                <field name="device_name"/>
                <field name="user_id"
                       string="User"
                       widget="many2one_avatar_user"/>

                <field name="token"
                       string="FCM Token"
                       optional="hide"/>
                <field name="device_platform"/>
                <field name="device_os"/>
                <field name="device_browser"/>

                <field name="is_mobile"/>
                <field name="ip_address"/>
                <field name="last_seen"/>
                <field name="login_count"/>
                <field name="last_seen"
                       string="Last Seen"
                       widget="remaining_days"/>
                <field name="create_date"
                       string="Created On"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Kanban View - No permite crear -->
    <record id="view_fcm_device_kanban" model="ir.ui.view">
        <field name="name">fcm.device.kanban</field>
        <field name="model">fcm.device</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile"
                    create="false">
                <field name="device_name"/>
                <field name="user_id"/>
                <field name="platform"/>
                <field name="token"/>
                <field name="last_seen"/>
                <field name="active"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click {{ record.active.raw_value ? 'bg-success-light' : 'bg-danger-light' }}">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="device_name"/>
                                    </strong>
                                    <span class="o_kanban_record_subtitle">
                                        <field name="user_id"/>
                                    </span>
                                </div>
                                <span t-if="!record.active.raw_value"
                                      class="badge bg-danger">
                                    Inactive
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <ul class="list-unstyled">
                                    <li>
                                        <i class="fa fa-mobile me-1" role="img"/>
                                        <field name="platform"/>
                                    </li>
                                    <li>
                                        <i class="fa fa-clock-o me-1" role="img"/>
                                        <field name="last_seen"
                                               widget="remaining_days"/>
                                    </li>
                                    <li>
                                        <i class="fa fa-key me-1" role="img"/>
                                        <small>
                                            <field name="token"/>
                                        </small>
                                    </li>
                                </ul>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="active"
                                           widget="boolean_toggle"
                                           string="Active"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_fcm_device_search" model="ir.ui.view">
        <field name="name">fcm.device.search</field>
        <field name="model">fcm.device</field>
        <field name="arch" type="xml">
            <search string="Search FCM Devices">

                <field name="user_id"
                       string="User"/>
                <field name="token"
                       string="FCM Token"/>
                <field name="platform"
                       string="Platform"/>

                <separator/>

                <filter string="Active Devices"
                        name="active"
                        domain="[('active', '=', True)]"/>
                <filter string="Inactive Devices"
                        name="inactive"
                        domain="[('active', '=', False)]"/>
                <filter string="Android"
                        name="android"
                        domain="[('platform', '=', 'android')]"/>
                <filter string="iOS"
                        name="ios"
                        domain="[('platform', '=', 'ios')]"/>

                <separator/>



                <group expand="0" string="Group By">
                    <filter string="Platform"
                            name="group_platform"
                            domain="[]"
                            context="{'group_by': 'platform'}"/>
                    <filter string="User"
                            name="group_user"
                            domain="[]"
                            context="{'group_by': 'user_id'}"/>
                    <filter string="Status"
                            name="group_active"
                            domain="[]"
                            context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_fcm_device" model="ir.actions.act_window">
        <field name="name">FCM Devices</field>
        <field name="res_model">fcm.device</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_fcm_device_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No FCM devices registered yet
            </p>
            <p>
                Device tokens are automatically registered from the mobile app.
                Use the buttons to test configuration or clean up invalid tokens.
            </p>
        </field>
    </record>

</odoo>