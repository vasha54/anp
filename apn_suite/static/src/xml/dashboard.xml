<?xml version="1.0" encoding="UTF-8" ?>
<templates>
  <t t-name="apn_suite.APNDashboardTemplate">
    <t t-set="txt_all_rights_reserved" t-trans=". All rights reserved">. All rights reserved</t>
    <t t-set="txt_designed_by" t-trans="Designed by">Designed by</t>
    <t t-set="txt_welcome" t-trans="Welcome">Welcome</t>

    <div class="container-fluid" style="display: flex; flex-direction: column; height: 100vh; overflow: hidden; margin: 0; padding: 0; background-color: #ecececf5">
      <main id="main" class="main" style="flex: 1 1 auto; overflow-y: auto;">
        <section class="section dashboard">
          <!-- Panel de bienvenida al usuario -->
          <div class="row mb-4">
            <div class="col-12">
              <div class="card welcome-card" style="border-radius: 15px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); border: none;">
                <div class="card-body p-3">
                  <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                      <h4 class="mb-2" style="color: #012970; font-weight: 600;">
                        <t t-esc="txt_welcome"/>,
                        <span t-esc="state.user_name" style="color: #4154f1;"/>
                        <span>!</span>
                      </h4>
                      <p class="text-muted mb-0" style="font-size: 0.95rem;">
                        <t t-esc="state.user_email"/>
                      </p>
                    </div>

                    <!-- Componente de filtro alineado a la derecha -->
                    <DateFilterComponent onFilter="onFilterChange"/>

                  </div>
                </div>
              </div>
            </div>
          </div>


          <div class="row mt-4 g-4">
              <div class="col-xxl-6 col-lg-6 col-md-6">
                <div class="row g-4">
                  <div class="col-xxl-6 col-lg-6 col-md-6">
                      <OccupancyCard
                              occupancyRate="state.kpis.occupancyRate"
                              trend="state.kpis.occupancyTrend"
                              isLoading="state.isLoading"
                      />
                  </div>
                  <div class="col-xxl-6 col-lg-6 col-md-6">
                      <RevenueCard
                              totalRevenue="state.kpis.totalRevenue"
                              trend="state.kpis.revenueTrend"
                              isLoading="state.isLoading"
                      />
                  </div>
                  <div class="col-xxl-6 col-lg-6 col-md-6">
                      <ClassesCard
                              totalClasses="state.kpis.totalClasses"
                              trend="state.kpis.classesTrend"
                              isLoading="state.isLoading"
                      />
                  </div>
                  <div class="col-xxl-6 col-lg-6 col-md-6">
                      <NewClientsCard
                              newClients="state.kpis.newClients"
                              trend="state.kpis.clientsTrend"
                              isLoading="state.isLoading"
                      />
                  </div>
                </div>

              </div>

              <div class="col-xxl-3 col-lg-3 col-md-6">
                  <CardInfoDistributionRevenue/>
              </div>
              <div class="col-xxl-6 col-lg-6 col-md-6">
                  <CardInfoWeeklyAttendanceTrend/>
              </div>
              <div class="col-xxl-6 col-lg-6 col-md-6">
                  <CardInfoMostDemandClasses/>
              </div>

          </div>
        </section>
      </main>
      <footer id="footer" class="footer text-center" style="flex-shrink: 0; border-top: 1px solid #dee2e6; padding-top: 15px;">
        <div class="copyright">
          &#169; Copyright <strong>
            <span>Pilates</span>
          </strong><t t-esc="txt_all_rights_reserved"/>
        </div>
        <div class="credits">
          <t t-esc="txt_designed_by"/> <a target="_blank" href="https://www.idoogroup.com">IdooGroup</a>
        </div>
      </footer>
      <div style="min-height:50px; background-color:#ffffff !important;"></div>
    </div>
  </t>
</templates>