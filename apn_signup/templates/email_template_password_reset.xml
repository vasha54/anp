<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="email_template_password_reset" model="mail.template">
            <field name="name">Password Reset Request</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="email_from">noreply@example.com</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">Password Reset Request - APN Pilates</field>
            <field name="body_html">
                <![CDATA[
                <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
                    <div style="text-align: center; margin-bottom: 30px;">
                        <h1 style="color: #333;">Password Reset Request</h1>
                    </div>

                    <div style="background-color: #f9f9f9; padding: 30px; border-radius: 10px;">
                        <p>Hello <strong>${object.name}</strong>,</p>

                        <p>We received a request to reset your password. If you didn't make this request, you can ignore this email.</p>

                        <div style="background-color: #fff; border: 2px solid #007bff; border-radius: 10px; padding: 20px; margin: 20px 0; text-align: center;">
                            <p style="font-size: 14px; color: #666; margin-bottom: 10px;">Your verification code is:</p>
                            <p style="font-size: 32px; font-weight: bold; color: #007bff; letter-spacing: 5px; margin: 10px 0;">
                                ${ctx.get('reset_code', '000000')}
                            </p>
                            <p style="font-size: 12px; color: #999;">This code expires in 30 minutes</p>
                        </div>

                        <div style="text-align: center; margin: 30px 0;">
                            <p style="margin-bottom: 10px;">Or click the button below to reset your password:</p>
                            <a href="${object.company_id.website or 'http://localhost:8069'}/reset-password?email=${object.email}&amp;token=${ctx.get('reset_token', '')}"
                               style="background-color: #007bff; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px; font-weight: bold; display: inline-block;">
                                Reset Password
                            </a>
                        </div>

                        <div style="background-color: #fff3cd; border: 1px solid #ffeaa7; padding: 15px; border-radius: 5px; margin: 20px 0;">
                            <p style="margin: 0; color: #856404;">
                                <strong>Security Notice:</strong> This link and code will expire in 30 minutes.
                                For your security, never share this code with anyone.
                            </p>
                        </div>

                        <t t-if="ctx.get('device_info')">
                            <div style="background-color: #f8f9fa; padding: 10px; border-radius: 5px; margin-top: 20px;">
                                <p style="font-size: 12px; color: #666; margin: 0;">
                                    <strong>Request details:</strong><br/>
                                    Device: ${ctx['device_info'].get('os', 'Unknown')} |
                                    Platform: ${ctx['device_info'].get('platform', 'Unknown')}
                                </p>
                            </div>
                        </t>

                        <p style="margin-top: 20px; color: #666;">
                            If you didn't request this password reset, please secure your account immediately.
                        </p>
                    </div>

                    <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee; text-align: center; color: #999;">
                        <p>This is an automated message, please do not reply.</p>
                    </div>
                </div>
                ]]>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
</odoo>