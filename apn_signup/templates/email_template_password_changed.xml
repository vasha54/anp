<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Email Template for Password Changed Confirmation -->
        <record id="email_template_password_changed" model="mail.template">
            <field name="name">Password Changed Confirmation</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="email_from">noreply@example.com</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">Your Password Has Been Changed</field>
            <field name="body_html">
                <![CDATA[
                <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
                    <div style="text-align: center; margin-bottom: 30px;">
                        <h1 style="color: #333;">Password Changed</h1>
                    </div>

                    <div style="background-color: #f9f9f9; padding: 30px; border-radius: 10px;">
                        <p>Hello <strong>${object.name}</strong>,</p>

                        <p>Your password has been successfully changed.</p>

                        <div style="background-color: #d4edda; border: 1px solid #c3e6cb; padding: 15px; border-radius: 5px; margin: 20px 0;">
                            <p style="margin: 0; color: #155724;">
                                <strong>✓ Password updated successfully</strong>
                            </p>
                        </div>

                        <p>If you did not make this change, please contact support immediately.</p>
                    </div>

                    <div style="margin-top: 30px; text-align: center; color: #999; font-size: 12px;">
                        <p>Time: ${object.last_password_reset or ''}</p>
                    </div>
                </div>
                ]]>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
</odoo>